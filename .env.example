# Local development only. Never commit a real .env file.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio

# Portfolio owner
PORTFOLIO_NAME=Shivam Sharma
CONTACT_EMAIL=you@example.com
CONTACT_PHONE=
CONTACT_LOCATION=
CONTACT_AVAILABILITY=Open to opportunities
GITHUB_URL=https://github.com/
LINKEDIN_URL=https://linkedin.com/
TWITTER_URL=https://x.com/

# SMTP email settings
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, use a Google App Password.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password-or-app-password
MAIL_FROM="Your Name <your-email@example.com>"
