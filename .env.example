PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas
# Replace <db_password> with the password for myAtlasDBUser.
MONGODB_URI=
MONGODB_DB_NAME=portfolio


# Portfolio owner
PORTFOLIO_NAME=Your Name
CONTACT_EMAIL=you@example.com
CONTACT_PHONE=
CONTACT_LOCATION=
CONTACT_AVAILABILITY=Open to opportunities
GITHUB_URL=https://github.com/
LINKEDIN_URL=https://linkedin.com/
TWITTER_URL=https://twitter.com/

# SMTP email settings
# Example: Gmail SMTP uses smtp.gmail.com and port 465 with SMTP_SECURE=true.
# For Gmail, use a Google App Password instead of your normal account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password-or-app-password
MAIL_FROM="Your Name <your-email@example.com>"
