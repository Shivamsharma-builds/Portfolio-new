{
  "name": "portfolio-root",
  "private": true,
  "version": "1.0.0",
  "description": "Root for client and server portfolio project",
  "scripts": {
    "install:client": "npm install --prefix Client",
    "install:server": "npm install --prefix Server",
    "install": "npm run install:client && npm run install:server",
    "dev:client": "npm run dev --prefix Client",
    "start:server": "npm start --prefix Server",
    "dev": "npm-run-all --parallel dev:client start:server"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
